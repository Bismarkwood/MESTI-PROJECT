# Copy to .env and adjust. AWS credentials are read from your environment / AWS
# CLI profile (the same ones `aws sts get-caller-identity` uses) — do NOT put
# secret keys here.

# Port the WebSocket bridge listens on.
PORT=8080

# AWS region that has Nova Sonic + Bedrock model access enabled.
AWS_REGION=us-east-1

# Nova Sonic model id (voice / speech-to-speech).
NOVA_SONIC_MODEL_ID=amazon.nova-sonic-v1:0

# Bedrock text model for chat (Converse API + tool use). Claude needs the
# region inference-profile prefix (us.) for on-demand invocation.
BEDROCK_TEXT_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0

# ── Text-to-speech ─────────────────────────────────────────────────────────
# Which TTS provider to use: deepgram | polly. Defaults to deepgram when
# DEEPGRAM_API_KEY is set, otherwise polly.
TTS_PROVIDER=deepgram

# Deepgram Aura 2 (recommended). Get a key at https://console.deepgram.com.
# In production, load this from AWS Secrets Manager instead of a file.
DEEPGRAM_API_KEY=
DEEPGRAM_VOICE=aura-2-thalia-en

# Amazon Polly fallback.
POLLY_ENGINE=generative
POLLY_VOICE_ID=Danielle
