# Frontend environment (Vite). Copy to .env.local and adjust if your assistant
# server does not run on the default localhost:8080.

# Bedrock text-chat endpoint (HTTP) served by the assistant server.
VITE_ASSISTANT_HTTP_URL=http://localhost:8080

# Nova Sonic voice endpoint (WebSocket) served by the assistant server.
VITE_ASSISTANT_WS_URL=ws://localhost:8080
